
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Akashic Gita Matrix</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@100;300;400;500;700;900&family=Fira+Code:wght@300;500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    
    <script type="importmap">
    {
      "imports": {
        "react-dom/": "https://esm.sh/react-dom@^19.2.3/",
        "react/": "https://esm.sh/react@^19.2.3/",
        "react": "https://esm.sh/react@^19.2.3",
        "@google/genai": "https://esm.sh/@google/genai@^1.35.0",
        "d3": "https://esm.sh/d3@^7.9.0"
      }
    }
    </script>
</head>
<body>
    <canvas id="akashic-bg"></canvas>
    <div id="root"></div>
    <script type="module" src="/index.tsx"></script>
    <script>
      (function() {
        console.log("%c[Akashic System] Initializing Neural Bridge...", "color: #ff00ff; font-family: monospace;");
        
        // 2Pi/8 Agents Configuration (8 Directions/Octants)
        const AGENTS = [
          { id: 'EAST', label: 'Indra-Cognition', angle: 0 },
          { id: 'SE', label: 'Agni-Transformation', angle: Math.PI / 4 },
          { id: 'SOUTH', label: 'Yama-Regulation', angle: Math.PI / 2 },
          { id: 'SW', label: 'Nirrti-Dissolution', angle: 3 * Math.PI / 4 },
          { id: 'WEST', label: 'Varuna-Unconscious', angle: Math.PI },
          { id: 'NW', label: 'Vayu-Movement', angle: 5 * Math.PI / 4 },
          { id: 'NORTH', label: 'Kubera-Structure', angle: 3 * Math.PI / 2 },
          { id: 'NE', label: 'Ishana-Source', angle: 7 * Math.PI / 4 }
        ];

        class OllamaBridge {
          constructor() {
            this.endpoint = "http://localhost:11434";
            this.model = "llama3:slim"; // Presumed 'slim-edition'
            this.isConnected = false;
            this.agents = AGENTS.map(a => ({ ...a, entropy: Math.random(), status: 'idle' }));
            this.entropyShiftInterval = null;
            
            this.init();
          }

          async init() {
            try {
              // Attempt handshake with local Ollama instance
              const controller = new AbortController();
              const timeoutId = setTimeout(() => controller.abort(), 2000);
              const response = await fetch(`${this.endpoint}/api/tags`, { signal: controller.signal });
              clearTimeout(timeoutId);
              
              if (response.ok) {
                this.isConnected = true;
                console.log("%c[Ollama Bridge] Connection Established: Localhost:11434", "color: #00ff80");
                this.startEntropyWorkflow();
              } else {
                throw new Error("Endpoint unreachable");
              }
            } catch (e) {
              console.warn("[Ollama Bridge] Localhost not detected. System running in detached simulation mode.");
              this.startEntropyWorkflow(true); // Run simulated entropy even if disconnected
            }
          }

          // 2Pi/8 Shifted Entropy Workflow
          startEntropyWorkflow(simulated = false) {
            if (this.entropyShiftInterval) clearInterval(this.entropyShiftInterval);
            
            this.entropyShiftInterval = setInterval(() => {
              // Shift entropy clockwise (2Pi/8 shift)
              const prevEntropy = this.agents.map(a => a.entropy);
              
              this.agents.forEach((agent, i) => {
                const sourceIndex = (i - 1 + 8) % 8;
                // Standard Shift + Quantum Noise Injection
                const noise = Math.random() * 0.1 - 0.05;
                agent.entropy = (prevEntropy[sourceIndex] * 0.9) + (Math.random() * 0.1) + noise;
                
                // Clamp
                agent.entropy = Math.max(0, Math.min(1, agent.entropy));
              });

              // Broadcast update to the React App (Akashic Matrix)
              window.dispatchEvent(new CustomEvent('akashic-entropy-update', { 
                detail: { 
                  agents: this.agents,
                  globalEntropy: this.agents.reduce((acc, curr) => acc + curr.entropy, 0) / 8,
                  timestamp: Date.now(),
                  simulated: simulated
                }
              }));
              
            }, 1000); // 1Hz Pulse
          }

          async generate(prompt) {
            if (!this.isConnected) return { error: "Neural Bridge Disconnected" };
            
            try {
              const response = await fetch(`${this.endpoint}/api/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  model: this.model,
                  prompt: prompt,
                  stream: false
                })
              });
              const data = await response.json();
              return data.response;
            } catch (e) {
              return { error: e.message };
            }
          }
        }

async function nexus(prompt){
 const r = await fetch("/api",{method:"POST",body:prompt});
 document.body.innerHTML += await r.text();
}


        // Expose to Window
        window.OllamaBridge = new OllamaBridge();
      })();
    </script>
</body>
</html>
